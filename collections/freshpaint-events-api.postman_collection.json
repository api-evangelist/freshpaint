                    "track"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "token",
                      "value": "<API Key>"
                    }
                  ],
                  "variable": []
                },
                "method": "POST",
                "body": {
