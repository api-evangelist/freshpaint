        {
          "id": "bcd34146-7b79-49b6-a24e-a42fd6873daf",
          "name": "Send a server-side event to Freshpaint.",
          "request": {
            "name": "Send a server-side event to Freshpaint.",
            "description": {
              "content": "Send a single server-side event to Freshpaint. The event is routed to all active destinations unless restricted via the $options property. Reserved event names ($identify, $page, $screen) drive identify, page, and screen behavior; any other value of `event` is treated as a custom tracked event. The environment token is supplied in properties.token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "track"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"<string>\",\n  \"properties\": {\n    \"distinct_id\": \"<string>\",\n    \"token\": \"<string>\",\n    \"time\": \"<long>\",\n    \"$device_id\": \"<string>\",\n    \"$insert_id\": \"<string>\",\n    \"$ip\": \"<string>\",\n    \"$user_props\": {\n      \"key_0\": \"string\"\n    },\n    \"$options\": {\n      \"key_0\": 1365.7869261977207\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ecfd8dd1-194a-4ccb-972b-3993cd2c1a69",
              "name": "Event accepted for ingestion.",
